# Password needed to open the CRM. Leave unset ONLY on localhost —
# without it the app serves every lead's details to anyone with the URL.
APP_PASSWORD=change-me-to-something-long

# Optional. Pins the session signing key so logins survive a volume reset.
# If unset, one is generated at DATA_DIR/session.key on first boot.
SESSION_SECRET=

# Where crm.db lives. On Railway/Render point this at the mounted volume.
DATA_DIR=/data

# The host sets this automatically; only override locally.
PORT=4300
